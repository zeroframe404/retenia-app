      "notes": [
        {
          "title": "Intervalos de confianza",
          "topic": "Intervalos de confianza",
          "blocks": [
            {
              "depth": 0,
              "parts": [
                {
                  "text": "Un intervalo de confianza da un rango de valores plausibles para un parámetro, por ejemplo la media de la población."
                }
              ]
            },
            {
              "depth": 0,
              "parts": [
                {
                  "text": "Error estándar de la media: s / sqrt(n)"
                }
              ]
            },
            {
              "depth": 1,
              "parts": [
                {
                  "text": "s es el desvío de la muestra y n es su tamaño."
                }
              ]
            },
            {
              "depth": 0,
              "parts": [
                {
                  "text": "El intervalo para la media: $\\bar{x} \\pm t \\cdot s/\\sqrt{n}$"
                }
              ]
            },
            {
              "depth": 0,
              "parts": [
                {
                  "text": "varianza: el promedio de los cuadrados de las distancias a la media."
                }
              ]
            },
            {
              "depth": 0,
              "parts": [
                {
                  "text": "El 95 % no es la probabilidad de que la media esté en este intervalo: habla del procedimiento."
                }
              ]
            },
            {
              "depth": 0,
              "parts": [
                {
                  "image": "campana",
                  "alt": "Curva normal, la campana de Gauss"
                }
              ]
            },
            {
              "depth": 0,
              "parts": [
                {
                  "text": "Ver también "
                },
                {
                  "link": "Media y desvío"
                }
              ]
            }
          ]
        },
        {
          "title": "Media y desvío",
          "topic": "Media y dispersión",
          "blocks": [
            {
              "depth": 0,
              "parts": [
                {
                  "text": "La media es el promedio de los datos: se suman los valores y se divide por la cantidad."
                }
              ]
            },
            {
              "depth": 0,
              "parts": [
                {
                  "text": "El desvío estándar mide cuánto se alejan, en promedio, los datos de la media."
                }
              ]
            },
            {
              "depth": 1,
              "parts": [
                {
                  "text": "Es la raíz cuadrada de la varianza."
                }
              ]
            },
            {
              "depth": 0,
              "parts": [
                {
                  "text": "Para ver cómo se usa en un intervalo: "
                },
                {
                  "link": "Intervalos de confianza"
                }
              ]
            }
          ]
        }
      ]
