    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "5.0.4",
    "axe-core": "4.14.0",
    "dependency-cruiser": "18.6.0",
    "electron": "44.7.0",
    "electron-vite": "5.0.0",
    "fast-check": "4.10.2",
    "knip": "6.41.0",
    "lefthook": "2.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "secretlint": "13.0.7",
    "typescript": "7.0.2",
    "vite": "7.3.7",
