{
  "$schema": "./node_modules/knip/schema.json",
  "entry": [
    "src/main/index.ts",
    "src/preload/index.ts",
    "src/renderer/main.tsx",
    "src/renderer/globals.d.ts",
    "tools/*.mjs",
    "tools/hooks/*.mjs",
    "playwright.instalado.config.ts",
    "tests/instalado/*.spec.ts",
    "tests/sabotage/*.mjs",
    // El programa hijo de la prueba del corte: lo arma Vite por su ruta (tests/apoyo/corte.ts).
    "tests/apoyo/escritura-cortada.ts"
  ],
  "project": ["src/**/*.{ts,tsx}", "tools/**/*.mjs", "tests/**/*.{ts,mjs}"],
  // La red los corre por su ruta (tools/lib/proceso.mjs; así se arma el instalador con
  // electron-builder) y secretlint carga su conjunto de reglas desde .secretlintrc.json: knip
  // no puede verlos solo.
  "ignoreDependencies": [
    "secretlint",
    "@secretlint/secretlint-rule-preset-recommend",
    "electron-builder"
  ],
  // Programas de Windows que usan el tablero (abrir el navegador) y el corte de procesos.
  "ignoreBinaries": ["explorer.exe", "taskkill"]
}
