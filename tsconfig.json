{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024"],
    "types": ["node"],
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "src/core/**/*.ts",
    "src/data/**/*.ts",
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "tests/**/*.ts",
    "*.config.ts"
  ],
  "exclude": ["tests/e2e/**", "tests/componentes/**", "tests/instalado/**"]
}
